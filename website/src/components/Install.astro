---
import { INSTALL_COMMAND, INIT_COMMAND, DOCS_GETTING_STARTED } from '../site';
---

<section id="install" class="section">
  <div class="container">
    <h2 class="section-title">Get started</h2>
    <p class="muted">Install the CLI globally, then initialize your project.</p>
    <div class="code-block" style="margin: 1.5rem 0 1rem;">
      <code>{INSTALL_COMMAND}</code>
    </div>
    <div class="code-block">
      <code>{INIT_COMMAND}</code>
    </div>
    <p class="muted" style="margin-top: 1.5rem;">
      See <a href={DOCS_GETTING_STARTED} target="_blank" rel="noopener noreferrer">Getting started</a> on
      GitHub for the full walkthrough.
    </p>
  </div>
</section>
