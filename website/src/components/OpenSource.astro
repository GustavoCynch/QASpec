---
import { OPEN_SOURCE } from '../site';
---

<section class="block" id="open-source">
  <div class="wrap os-grid">
    <div>
      <div class="label" style="margin-bottom: 16px;">05 — Open source</div>
      <h2 style="font-size: clamp(28px, 3.4vw, 40px); letter-spacing: -0.015em;">
        Built in the open.
      </h2>
      <p class="lead" style="color: var(--muted); margin-top: 16px; max-width: 44ch;">
        {OPEN_SOURCE.lead}
      </p>
      <div class="mit">
        <span>LICENSE</span><span style="color: var(--faint);">·</span><span
          >{OPEN_SOURCE.license}</span
        >
      </div>
    </div>
    <div class="os-points">
      {
        OPEN_SOURCE.points.map((point) => (
          <div class="os-point">
            <span class="tick">✓</span>
            <span>{point}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
