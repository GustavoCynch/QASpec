---
import { SUPPORTED_TOOLS, DOCS_SUPPORTED_TOOLS } from '../site';
---

<section id="tools" class="section">
  <div class="container">
    <h2 class="section-title">Supported tools</h2>
    <p class="muted">
      Run <span class="mono">qaspec init</span> to install skills and <span class="mono">/qsx:*</span> commands
      for your agents. Native support includes:
    </p>
    <div class="tools-grid" style="margin: 1.5rem 0;">
      {SUPPORTED_TOOLS.map((tool) => (
        <span class="tool-pill">{tool}</span>
      ))}
      <span class="tool-pill">+ more</span>
    </div>
    <p class="muted">
      <a href={DOCS_SUPPORTED_TOOLS} target="_blank" rel="noopener noreferrer">Full tool list and paths</a>
    </p>
  </div>
</section>
