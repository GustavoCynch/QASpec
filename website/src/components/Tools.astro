---
import { SUPPORTED_TOOLS, DOCS_SUPPORTED_TOOLS } from '../site';
---

<section class="block" id="tools">
  <div class="wrap">
    <div class="block-head">
      <div class="label">04 — Supported tools</div>
      <h2>Works with your agent.</h2>
    </div>
    <div class="tools-grid">
      {SUPPORTED_TOOLS.map((tool) => <div class="tool">{tool}</div>)}
    </div>
    <p class="tools-note">
      Subset shown — full list in <a
        href={DOCS_SUPPORTED_TOOLS}
        target="_blank"
        rel="noopener noreferrer">docs/supported-tools.md</a
      >
    </p>
  </div>
</section>
