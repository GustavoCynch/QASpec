---
import { FAQ } from '../site';
---

<section id="faq" class="section">
  <div class="container">
    <h2 class="section-title">FAQ</h2>
    {FAQ.map((item) => (
      <article class="faq-item">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </article>
    ))}
  </div>
</section>
